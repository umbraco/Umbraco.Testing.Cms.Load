import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
try {
    def json = new JsonSlurper().parseText(body)
    if (json.access_token) vars.put(&quot;access_token&quot;, json.access_token)
} catch(Exception e) {
    log.warn(&quot;refresh token update failed: &quot; + e.getMessage())
}
