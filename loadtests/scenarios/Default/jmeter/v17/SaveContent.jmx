import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
try {
    def items = new JsonSlurper().parseText(body).items
    if (items &amp;&amp; items.size() &gt; 0) {
        def item = items[new Random().nextInt(items.size())]
        def id = item.id.toString()
        def firstVariantState = item.variants ? item.variants[0]?.state?.toString() : null
        def published = (firstVariantState == &quot;Published&quot;) ? &quot;true&quot; : &quot;false&quot;
        // Update target_document_id to deepest found level
        vars.put(&quot;node_id_l3&quot;, id)
        vars.put(&quot;target_document_id&quot;, id)
        vars.put(&quot;published_l3&quot;, published)
        log.info(&quot;target_document_id=&quot; + id + &quot; published_l3=&quot; + published + &quot; state=&quot; + firstVariantState)
    } else {
        vars.put(&quot;node_id_l3&quot;, &quot;NODE_ID_L3_NOT_FOUND&quot;)
        vars.put(&quot;published_l3&quot;, &quot;false&quot;)
        log.warn(&quot;No items at level 4 – target_document_id stays at level 3&quot;)
    }
} catch(Exception e) {
    vars.put(&quot;node_id_l3&quot;, &quot;NODE_ID_L3_NOT_FOUND&quot;)
    vars.put(&quot;published_l3&quot;, &quot;false&quot;)
    log.error(&quot;Extract target_document_id failed: &quot; + e.getMessage())
}
