          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /umbraco/management/api/v1/security/back-office/token (authorization_code)" enabled="true">
            <stringProp name="HTTPSampler.path">/umbraco/management/api/v1/security/back-office/token</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
