import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
try {
    def json = new JsonSlurper().parseText(body)
    vars.put(&quot;access_token&quot;,  json.access_token  ?: &quot;ACCESS_TOKEN_NOT_FOUND&quot;)
    vars.put(&quot;refresh_token&quot;, json.refresh_token ?: &quot;REFRESH_TOKEN_NOT_FOUND&quot;)
} catch(Exception e) {
    vars.put(&quot;access_token&quot;,  &quot;ACCESS_TOKEN_NOT_FOUND&quot;)
    vars.put(&quot;refresh_token&quot;, &quot;REFRESH_TOKEN_NOT_FOUND&quot;)
    log.error(&quot;token extract failed: &quot; + e.getMessage())
}
