# Hand-craftable test_cases for local `terraform plan`. The pipeline builds
# this via scripts/prepare-test-cases.ps1.

resource_name_prefix    = "umbraco-loadtest"
resource_group_name     = "umbraco-loadtest-rg"
resource_group_location = "West Europe"
seeder_preset           = "Medium"   # Small / Medium / Large / Massive

# Tier values must exist in loadtests/tiers.json. app_settings_overlay normally
# comes from the validator; hand-write a small one for local plans.
test_cases = {
  "17.0.0__Standard__Default" = {
    dotnet_version       = "v10.0"
    umbraco_version      = "17.0.0"
    tier                 = "Standard"
    scenario             = "Default"
    app_settings_overlay = {}
  }
  "17.0.0__Pro__Default" = {
    dotnet_version       = "v10.0"
    umbraco_version      = "17.0.0"
    tier                 = "Pro"
    scenario             = "Default"
    app_settings_overlay = {}
  }
}

# Azure credentials normally flow via ARM_CLIENT_ID / ARM_CLIENT_SECRET / ARM_TENANT_ID.
# client_id     = ""
# client_secret = ""
# tenant_id     = ""
