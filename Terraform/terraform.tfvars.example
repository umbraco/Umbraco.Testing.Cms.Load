# Umbraco Load Test Configuration
# Copy this file to terraform.tfvars and customize values

# Resource naming
resource_name_prefix = "umbraco-load-test"
resource_group_name  = "umbraco-load-test-rg"

# Azure region
resource_group_location = "West Europe"

# App Service configuration
# Premium v3 (current Umbraco Cloud): P1v3 (2 core, 8 GB), P2v3 (4 cores, 16 GB), P3v3 (8 cores, 32 GB)
# Premium v4 (Umbraco Cloud Dedicated): P0v4, P1v4, P2v4, P3v4, P1mv4-P5mv4
app_service_plan_sku = "P1v3"

# SQL Database configuration
sql_sku         = "S0"  # Options: S0, S1, S2
sql_max_size_gb = 5     # Range: 1-100

# Data seeder preset
seeder_preset = "Medium"  # Options: Small, Medium, Large, Massive

# Umbraco versions to test (up to 4)
# Each entry requires dotnet_version and umbraco_version
umbraco_cms_versions = {
  "version14" = {
    dotnet_version  = "v8.0"
    umbraco_version = "14.3.0"
  }
  "version15" = {
    dotnet_version  = "v9.0"
    umbraco_version = "15.1.0"
  }
  "version16" = {
    dotnet_version  = "v9.0"
    umbraco_version = "16.0.0"
  }
  "version17" = {
    dotnet_version  = "v9.0"
    umbraco_version = "17.0.0"
  }
}

# Azure credentials (set via environment variables or Azure CLI login)
# client_id     = ""  # Set via ARM_CLIENT_ID env var
# client_secret = ""  # Set via ARM_CLIENT_SECRET env var
# tenant_id     = ""  # Set via ARM_TENANT_ID env var
